---
import DeviceFrame from "./DeviceFrame.astro";
import type { FrameName } from "../data/frames";

interface Screenshot {
  src: string;
  label: string;
}

interface Props {
  screenshots: Screenshot[];
  title: string;
  /** Device frame drawn around every screenshot. */
  frame?: FrameName;
  class?: string;
}

const { screenshots, title, frame = "ios-phone", class: className = "" } = Astro.props;
---

{/* Lives inside a project tile and runs edge to edge across it: the scroller's
    inline padding lines the first screenshot up with the tile's text, and the
    rest run off the right edge. Captions and controls draw in currentColor so
    the gallery follows whatever text color the tile sets. */}
<screenshot-gallery class:list={["block", className]}>
  <div
    class="scroller flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-8 px-8 no-scrollbar md:gap-5 md:scroll-px-12 md:px-12"
  >
    {
      /* Width drives the slide, not the caption: sizing from the image's
         height would let a long label stretch its own slide wider than the
         rest, leaving the screenshots unevenly spaced. */
      screenshots.map((shot) => (
        <div class="slide shrink-0 basis-[60%] snap-start sm:w-[220px] sm:basis-auto lg:w-[240px]">
          <DeviceFrame
            frame={frame}
            src={shot.src}
            alt={`${title} — ${shot.label}`}
            class="w-full drop-shadow-xl"
          />
          <p class="mt-3 text-center text-sm font-medium opacity-80">{shot.label}</p>
        </div>
      ))
    }
  </div>

  <div class="controls mt-6 flex items-center justify-center gap-3 px-8">
    <button
      type="button"
      class="prev inline-flex h-9 w-9 items-center justify-center rounded-full border border-current/30 transition-colors hover:bg-current/10 disabled:opacity-30 disabled:hover:bg-transparent"
      aria-label="Previous screenshots"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    {/* One dot per page, not per screenshot — how many slides fit on a page
        depends on the breakpoint, so the script fills this in at runtime. */}
    <div class="dots flex items-center gap-2"></div>

    <button
      type="button"
      class="next inline-flex h-9 w-9 items-center justify-center rounded-full border border-current/30 transition-colors hover:bg-current/10 disabled:opacity-30 disabled:hover:bg-transparent"
      aria-label="Next screenshots"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>
</screenshot-gallery>

<script>
  class ScreenshotGallery extends HTMLElement {
    connectedCallback() {
      const scroller = this.querySelector<HTMLElement>(".scroller");
      const slides = Array.from(this.querySelectorAll<HTMLElement>(".slide"));
      const dotsWrap = this.querySelector<HTMLElement>(".dots");
      const prev = this.querySelector<HTMLButtonElement>(".prev");
      const next = this.querySelector<HTMLButtonElement>(".next");
      const controls = this.querySelector<HTMLElement>(".controls");
      if (!scroller || slides.length < 2) {
        controls?.remove();
        return;
      }

      // Sub-pixel layout means scroll positions never land on exact integers.
      const EPS = 2;

      // A "page" is the visible run of slides — the scroller's width minus its
      // inline padding — which is what prev/next step by, so four visible
      // screenshots out of eight is two pages, not eight.
      const pageStep = () => {
        const style = getComputedStyle(scroller);
        const inset = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
        return Math.max(1, scroller.clientWidth - inset);
      };
      const maxScroll = () => scroller.scrollWidth - scroller.clientWidth;
      const pageCount = () => 1 + Math.ceil((maxScroll() - EPS) / pageStep());
      const currentPage = () => {
        // The last page is usually a partial one, so pin it by position.
        if (scroller.scrollLeft >= maxScroll() - EPS) return pageCount() - 1;
        return Math.round(scroller.scrollLeft / pageStep());
      };

      let dots: HTMLButtonElement[] = [];

      const buildDots = () => {
        const count = pageCount();
        if (!dotsWrap || dots.length === count) return;
        dotsWrap.replaceChildren();
        dots = Array.from({ length: count }, (_, i) => {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "dot h-2 w-2 rounded-full bg-current opacity-30 transition-opacity";
          dot.setAttribute("aria-label", `Go to page ${i + 1} of ${count}`);
          dot.addEventListener("click", () =>
            scroller.scrollTo({ left: i * pageStep(), behavior: "smooth" })
          );
          dotsWrap.append(dot);
          return dot;
        });
      };

      const sync = () => {
        if (!scroller.clientWidth) return;
        // Everything fits (a wide screen, or only a few screenshots): no paging.
        if (controls) controls.hidden = maxScroll() <= EPS;
        buildDots();
        const idx = currentPage();
        dots.forEach((d, i) => {
          d.classList.toggle("opacity-100", i === idx);
          d.classList.toggle("opacity-30", i !== idx);
        });
        if (prev) prev.disabled = scroller.scrollLeft <= EPS;
        if (next) next.disabled = scroller.scrollLeft >= maxScroll() - EPS;
      };

      // Drive the scroller directly. scrollIntoView() would walk every
      // scrollable ancestor and drag the page vertically along with it.
      const page = (dir: number) =>
        scroller.scrollBy({ left: dir * pageStep(), behavior: "smooth" });

      prev?.addEventListener("click", () => page(-1));
      next?.addEventListener("click", () => page(1));

      let queued = false;
      scroller.addEventListener(
        "scroll",
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            sync();
          });
        },
        { passive: true }
      );

      // Page count depends on the breakpoint, so recount whenever it resizes.
      new ResizeObserver(sync).observe(scroller);
      sync();
    }
  }

  if (!customElements.get("screenshot-gallery")) {
    customElements.define("screenshot-gallery", ScreenshotGallery);
  }
</script>
