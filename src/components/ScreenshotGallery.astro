---
interface Screenshot {
  src: string;
  label: string;
}

interface Props {
  screenshots: Screenshot[];
  title: string;
  class?: string;
}

const { screenshots, title, class: className = "" } = Astro.props;
---

<screenshot-gallery class:list={["block", className]}>
  <div
    class="scroller flex gap-4 overflow-x-auto snap-x snap-mandatory no-scrollbar"
  >
    {
      screenshots.map((shot) => (
        <div class="slide shrink-0 basis-[58%] snap-center sm:basis-auto">
          <div class="aspect-[1206/2622] w-full overflow-hidden rounded-xl border border-zinc-100 bg-zinc-50 sm:h-[400px] sm:w-auto">
            <img
              src={shot.src}
              alt={`${title} — ${shot.label}`}
              loading="lazy"
              class="h-full w-full object-contain"
            />
          </div>
          <p class="mt-2 text-center text-xs text-zinc-500">{shot.label}</p>
        </div>
      ))
    }
  </div>

  <div class="controls mt-4 flex items-center justify-center gap-3">
    <button
      type="button"
      class="prev inline-flex h-8 w-8 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-700 transition-colors hover:border-zinc-300 hover:bg-zinc-50 disabled:opacity-30"
      aria-label="Previous screenshot"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    {/* One dot per page, not per screenshot — how many slides fit on a page
        depends on the breakpoint, so the script fills this in at runtime. */}
    <div class="dots flex items-center gap-2"></div>

    <button
      type="button"
      class="next inline-flex h-8 w-8 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-700 transition-colors hover:border-zinc-300 hover:bg-zinc-50 disabled:opacity-30"
      aria-label="Next screenshot"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>
</screenshot-gallery>

<script>
  class ScreenshotGallery extends HTMLElement {
    connectedCallback() {
      const scroller = this.querySelector<HTMLElement>(".scroller");
      const slides = Array.from(this.querySelectorAll<HTMLElement>(".slide"));
      const dotsWrap = this.querySelector<HTMLElement>(".dots");
      const prev = this.querySelector<HTMLButtonElement>(".prev");
      const next = this.querySelector<HTMLButtonElement>(".next");
      if (!scroller || slides.length < 2) return;

      // Sub-pixel layout means scroll positions never land on exact integers.
      const EPS = 2;

      // A "page" is one scroller-width of slides, which is what prev/next step
      // by — so three visible screenshots out of six is two pages, not six.
      const pageCount = () =>
        Math.max(1, Math.ceil((scroller.scrollWidth - EPS) / scroller.clientWidth));
      const currentPage = () => Math.round(scroller.scrollLeft / scroller.clientWidth);

      let dots: HTMLButtonElement[] = [];

      const buildDots = () => {
        const count = pageCount();
        if (!dotsWrap || dots.length === count) return;
        dotsWrap.replaceChildren();
        dots = Array.from({ length: count }, (_, i) => {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "dot h-2 w-2 rounded-full bg-zinc-300 transition-colors";
          dot.setAttribute("aria-label", `Go to page ${i + 1} of ${count}`);
          dot.addEventListener("click", () =>
            scroller.scrollTo({ left: i * scroller.clientWidth, behavior: "smooth" })
          );
          dotsWrap.append(dot);
          return dot;
        });
      };

      const sync = () => {
        // Nothing measurable while the dialog is still closed; the
        // ResizeObserver calls back the moment it has a size.
        if (!scroller.clientWidth) return;
        buildDots();
        const idx = currentPage();
        dots.forEach((d, i) => {
          d.classList.toggle("bg-sky-500", i === idx);
          d.classList.toggle("bg-zinc-300", i !== idx);
        });
        // Disable from the scroll position rather than the page index: the last
        // page is usually a partial one, so it never reaches pageCount - 1.
        const maxScroll = scroller.scrollWidth - scroller.clientWidth;
        if (prev) prev.disabled = scroller.scrollLeft <= EPS;
        if (next) next.disabled = scroller.scrollLeft >= maxScroll - EPS;
      };

      // Drive the scroller directly. scrollIntoView() would walk every
      // scrollable ancestor and drag the modal body vertically along with it.
      const page = (dir: number) =>
        scroller.scrollBy({ left: dir * scroller.clientWidth, behavior: "smooth" });

      prev?.addEventListener("click", () => page(-1));
      next?.addEventListener("click", () => page(1));

      let queued = false;
      scroller.addEventListener(
        "scroll",
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            sync();
          });
        },
        { passive: true }
      );

      // The gallery lives in a closed <dialog>, so at connect time it has no
      // layout to measure — re-sync once it has been given a size.
      new ResizeObserver(sync).observe(scroller);
      sync();
    }
  }

  if (!customElements.get("screenshot-gallery")) {
    customElements.define("screenshot-gallery", ScreenshotGallery);
  }
</script>
