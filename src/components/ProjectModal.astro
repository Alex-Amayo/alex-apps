---
import ProjectLinks from "./ProjectLinks.astro";
import ScreenshotGallery from "./ScreenshotGallery.astro";

interface Props {
  id: string;
  title: string;
  longDescription: string;
  screenshots?: { src: string; label: string }[];
  logo?: string;
  logoInvert?: boolean;
  showTitle?: boolean;
  appStore?: string;
  playStore?: string;
  web?: string;
  github?: string;
  figma?: string;
}

const {
  id,
  title,
  longDescription,
  screenshots = [],
  logo,
  logoInvert,
  showTitle = true,
  appStore,
  playStore,
  web,
  github,
  figma,
} = Astro.props;

// Blank lines separate paragraphs in the write-up.
const paragraphs = longDescription.split(/\n\s*\n/).filter(Boolean);

// Projects with no links at all would otherwise leave the row's top margin
// as dead space under the last paragraph.
const hasLinks = Boolean(appStore || playStore || web || github || figma);

// The gallery is tall enough to push the dialog past a short viewport, so it
// also buys the modal extra width and a scrolling body. Projects without
// screenshots keep the narrower, self-sizing dialog.
// The scroll lives on the body rather than the dialog so the close button,
// positioned against the dialog, stays put while the content moves. The dialog
// needs no `relative` for that — a modal one is already `position: fixed`, and
// adding `relative` would override that and drop it back into page flow.
const hasShots = screenshots.length > 0;
const dialogSize = hasShots ? "max-w-2xl max-h-[85vh]" : "max-w-lg";
const bodyScroll = hasShots ? "overflow-y-auto" : "";
---

<dialog
  id={id}
  class={`project-modal m-auto w-[calc(100vw-2rem)] open:flex open:flex-col ${dialogSize} rounded-[28px] bg-white p-0 text-zinc-900 backdrop:bg-black/50`}
  aria-labelledby={`${id}-title`}
>
  <button
    type="button"
    data-modal-close
    aria-label="Close"
    class="absolute right-4 top-4 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/80 text-zinc-500 backdrop-blur transition-colors hover:bg-zinc-50 hover:text-zinc-900"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>

  <div class={`px-8 pb-8 pt-10 sm:px-10 sm:pb-10 ${bodyScroll}`}>
    <div class="flex flex-col items-center text-center">
      <div class="flex items-center gap-3">
        {logo && (
          <img
            src={logo}
            alt={`${title} logo`}
            class={`h-14 w-auto max-w-full object-contain sm:h-16 ${showTitle ? "w-14 sm:w-16" : ""} ${logoInvert ? "invert" : ""}`}
          />
        )}
        {showTitle && (
          <h3 id={`${id}-title`} class="text-2xl font-semibold tracking-tight sm:text-3xl">
            {title}
          </h3>
        )}
      </div>
      {!showTitle && <span id={`${id}-title`} class="sr-only">{title}</span>}

      <div class="mt-5 space-y-4 text-left text-base leading-relaxed text-zinc-500">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      {hasShots && (
        <ScreenshotGallery
          screenshots={screenshots}
          title={title}
          class="mt-7 w-full"
        />
      )}

      {hasLinks && (
        <ProjectLinks
          title={title}
          appStore={appStore}
          playStore={playStore}
          web={web}
          github={github}
          figma={figma}
          class="mt-7 flex flex-wrap justify-center gap-2"
        />
      )}
    </div>
  </div>
</dialog>

<style is:global>
  .project-modal[open] {
    animation: fade-scale 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .project-modal::backdrop {
    backdrop-filter: blur(2px);
  }
</style>

<script is:inline>
  if (!window._projectModalInit) {
    window._projectModalInit = true;

    document.addEventListener('click', function (e) {
      // Open
      var opener = e.target.closest('[data-modal-open]');
      if (opener) {
        var dialog = document.getElementById(opener.getAttribute('data-modal-open'));
        if (dialog) {
          dialog.showModal();
          window.posthog?.capture('project_learn_more_clicked', {
            project_name: opener.getAttribute('data-ph-project'),
          });
        }
        return;
      }

      // Close button
      var closer = e.target.closest('[data-modal-close]');
      if (closer) {
        closer.closest('dialog')?.close();
        return;
      }

      // Click on the backdrop (the dialog element itself, outside its content)
      if (e.target.tagName === 'DIALOG' && e.target.classList.contains('project-modal')) {
        e.target.close();
      }

    });
  }
</script>
