---
import ProjectModal from "./ProjectModal.astro";
import ProjectLinks from "./ProjectLinks.astro";
import ScreenshotGallery from "./ScreenshotGallery.astro";
import DeviceFrame from "./DeviceFrame.astro";
import { frames, type FrameName } from "../data/frames";

interface Device {
  frame: FrameName;
  src: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  subtitle?: string;
  longDescription?: string;
  /** Phone screenshots. On a full-width tile they replace `image` with a
   *  scrolling strip under the text. */
  screenshots?: { src: string; label: string }[];
  /** Device frame around each screenshot. Defaults to "ios-phone". */
  screenshotFrame?: FrameName;
  logo?: string;
  image?: string;
  imageAspect?: string;
  /** Screenshots bleed past the tile edge by default; set false to keep the
   *  image fully inside the padding (for framed or bordered art). */
  imageBleed?: boolean;
  /** Two screenshots in device frames, shown in place of `image`: the first is
   *  the large device at the back, the second sits in front of its lower-left
   *  corner. */
  devices?: [Device, Device];
  bg?: string;
  textColor?: string;
  logoInvert?: boolean;
  showTitle?: boolean;
  tags: string[];
  appStore?: string;
  playStore?: string;
  web?: string;
  github?: string;
  figma?: string;
  /** "row" (default) puts text and screenshot side by side, sized for a
   *  full-width tile. "stack" centers text above a full-width screenshot,
   *  for narrower tiles like a multi-project grid. */
  layout?: "row" | "stack";
  /** true = show the link pills right on the tile (code projects);
   *  false (default) = show a "Learn more" button that opens the modal. */
  inlineLinks?: boolean;
}

const {
  title,
  description,
  subtitle,
  longDescription = "",
  screenshots,
  screenshotFrame,
  logo,
  image,
  imageAspect = "1200 / 786",
  imageBleed = true,
  devices,
  bg = "#F5F5F6",
  textColor,
  logoInvert,
  showTitle = true,
  tags,
  appStore,
  playStore,
  web,
  github,
  figma,
  layout = "row",
  inlineLinks = false,
} = Astro.props;

const isStack = layout === "stack";

// A full-width tile with screenshots swaps the side-by-side image for a strip
// that runs the width of the tile under the text.
const hasGallery = !isStack && Boolean(screenshots?.length);

// One modal per project; the id ties the tile's button to its dialog.
const modalId = `project-modal-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

// When there's no separate title text, let the logo grow into the space
// both the logo and the title would otherwise share.
const logoClass = showTitle
  ? "h-16 w-16 rounded-[22%] object-contain sm:h-20 sm:w-20"
  : "h-14 w-auto max-w-full object-contain sm:h-20";

// Lay out the device pair in units of the composition's width: the back device
// takes most of it from the top-right corner, and the front one stands on the
// bottom edge, low enough to overlap the back device's lower-left corner.
const BACK_WIDTH = 84;
const FRONT_WIDTH = 28;
const OVERHANG = 10;
const deviceLayout = devices && (() => {
  const [back, front] = devices.map((d) => frames[d.frame]);
  const backHeight = BACK_WIDTH * (back.height / back.width);
  const frontHeight = FRONT_WIDTH * (front.height / front.width);
  return { aspect: `100 / ${Math.max(backHeight + OVERHANG, frontHeight)}` };
})();

const articleClass = hasGallery
  ? "flex h-full flex-col gap-10 overflow-hidden rounded-[28px] py-12 md:py-16"
  : `grid h-full grid-cols-1 items-center gap-8 overflow-hidden rounded-[28px] px-8 py-12 ${
  isStack ? "" : "md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-12 md:px-12"
} ${isStack ? "" : "md:py-16"}`;
const textWrapClass = `flex flex-col items-center text-center ${isStack ? "" : "md:items-start md:text-left"} ${hasGallery ? "px-8 md:px-12" : ""}`;
const rowJustifyClass = `mt-5 flex flex-wrap justify-center gap-2 ${isStack ? "" : "md:justify-start"}`;
const imageWrapClass = isStack
  ? "flex w-full items-center justify-center"
  : `flex items-center justify-center md:justify-end ${imageBleed ? "md:-my-16 md:-mr-12" : ""}`;
---

<article
  class={`${articleClass} ${textColor ? "" : "text-zinc-900"}`}
  style={`background-color:${bg};${textColor ? `color:${textColor}` : ""}`}
>
  <div class={textWrapClass}>
  <div class="flex items-center gap-3">
    {logo && (
      <img
        src={logo}
        alt={`${title} logo`}
        class={`${logoClass} ${logoInvert ? "invert" : ""}`}
      />
    )}
    {showTitle && (
      <h3 class={`text-2xl font-semibold tracking-tight sm:text-3xl ${textColor ? "" : "text-zinc-900"}`}>{title}</h3>
    )}
  </div>
  {subtitle && (
    <p class={`mt-4 max-w-md text-lg font-medium leading-snug tracking-tight sm:text-xl ${textColor ? "" : "text-zinc-900"}`}>
      {subtitle}
    </p>
  )}
  <p class={`${subtitle ? "mt-3" : "mt-4"} max-w-md text-base leading-relaxed sm:text-lg ${textColor ? "opacity-90" : "text-zinc-500"}`}>
    {description}
  </p>

  {tags.length > 0 && (
    <div class={rowJustifyClass}>
      {tags.map((tag) => (
        <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600">
          {tag}
        </span>
      ))}
    </div>
  )}

  {inlineLinks ? (
    <ProjectLinks
      title={title}
      appStore={appStore}
      playStore={playStore}
      web={web}
      github={github}
      figma={figma}
      size="xs"
      class={rowJustifyClass}
    />
  ) : (
    <div class={rowJustifyClass}>
      <button
        type="button"
        data-modal-open={modalId}
        data-ph-project={title}
        class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-300 hover:bg-zinc-50"
      >
        Learn more
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </div>
  )}

  </div>

  {hasGallery && screenshots && (
    <ScreenshotGallery screenshots={screenshots} frame={screenshotFrame} title={title} />
  )}

  {devices && deviceLayout && !hasGallery && (
    <div class="relative w-full" style={`aspect-ratio:${deviceLayout.aspect}`}>
      <div class="absolute right-0 top-0 drop-shadow-xl" style={`width:${BACK_WIDTH}%`}>
        <DeviceFrame frame={devices[0].frame} src={devices[0].src} alt={`${title} — ${devices[0].label}`} />
      </div>
      <div class="absolute bottom-0 left-0 drop-shadow-2xl" style={`width:${FRONT_WIDTH}%`}>
        <DeviceFrame frame={devices[1].frame} src={devices[1].src} alt={`${title} — ${devices[1].label}`} />
      </div>
    </div>
  )}

  {image && !devices && !hasGallery && (
    <div class={imageWrapClass} style={`aspect-ratio:${imageAspect}`}>
      <img src={image} alt={title} loading="lazy" class="h-full w-full object-contain" />
    </div>
  )}
</article>

{!inlineLinks && (
  <ProjectModal
    id={modalId}
    title={title}
    longDescription={longDescription}
    logo={logo}
    logoInvert={logoInvert}
    showTitle={showTitle}
    appStore={appStore}
    playStore={playStore}
    web={web}
    github={github}
    figma={figma}
  />
)}
