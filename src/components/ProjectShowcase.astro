---
import ProjectModal from "./ProjectModal.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  title: string;
  description: string;
  subtitle?: string;
  longDescription?: string;
  logo?: string;
  image?: string;
  imageAspect?: string;
  /** Screenshots bleed past the tile edge by default; set false to keep the
   *  image fully inside the padding (for framed or bordered art). */
  imageBleed?: boolean;
  /** Let the screenshot fill the tile's full height (top edge to bottom edge),
   *  cropping the sides instead of sitting in an `imageAspect` box. Row layout
   *  only — below md the tile stacks and the image sizes itself. */
  imageFullHeight?: boolean;
  /** CSS object-position for a full-height screenshot — which part survives the
   *  side crop, e.g. "left top", "left center", "20% top". Defaults to "left top". */
  imagePosition?: string;
  bg?: string;
  textColor?: string;
  logoInvert?: boolean;
  showTitle?: boolean;
  tags: string[];
  appStore?: string;
  playStore?: string;
  web?: string;
  github?: string;
  /** "row" (default) puts text and screenshot side by side, sized for a
   *  full-width tile. "stack" centers text above a full-width screenshot,
   *  for narrower tiles like a multi-project grid. */
  layout?: "row" | "stack";
  /** true = show the link pills right on the tile (code projects);
   *  false (default) = show a "Learn more" button that opens the modal. */
  inlineLinks?: boolean;
}

const {
  title,
  description,
  subtitle,
  longDescription = "",
  logo,
  image,
  imageAspect = "1200 / 786",
  imageBleed = true,
  imageFullHeight = false,
  imagePosition = "left top",
  bg = "#F5F5F6",
  textColor,
  logoInvert,
  showTitle = true,
  tags,
  appStore,
  playStore,
  web,
  github,
  layout = "row",
  inlineLinks = false,
} = Astro.props;

const isStack = layout === "stack";

// One modal per project; the id ties the tile's button to its dialog.
const modalId = `project-modal-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

// When there's no separate title text, let the logo grow into the space
// both the logo and the title would otherwise share.
const logoClass = showTitle
  ? "h-16 w-16 object-contain sm:h-20 sm:w-20"
  : "h-14 w-auto max-w-full object-contain sm:h-20";

// Full height (row layout, md and up) hands the tile's vertical padding to the
// text column so the image column can stretch the tile's whole height and run
// off the right edge. The `imageAspect` box is dropped — a fixed ratio would
// fight the stretch — so below md, where the tile is one column, the image just
// sizes itself from its own dimensions.
const fullHeight = imageFullHeight && !isStack;

const articleClass = `grid h-full grid-cols-1 items-center gap-8 overflow-hidden rounded-[28px] px-8 py-12 ${
  isStack ? "" : "md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-12 md:px-12"
} ${isStack || fullHeight ? "" : "md:py-16"} ${fullHeight ? "md:py-0 md:pr-0" : ""}`;
const textWrapClass = `flex flex-col items-center text-center ${isStack ? "" : "md:items-start md:text-left"} ${fullHeight ? "md:py-16" : ""}`;
const rowJustifyClass = `mt-5 flex flex-wrap justify-center gap-2 ${isStack ? "" : "md:justify-start"}`;
const imageWrapClass = isStack
  ? "flex w-full items-center justify-center"
  : `flex items-center justify-center md:justify-end ${
      fullHeight
        ? "overflow-hidden md:h-full md:self-stretch"
        : imageBleed
          ? "md:-my-16 md:-mr-12"
          : ""
    }`;
const imageClass = fullHeight
  ? "h-auto w-full object-contain md:h-full md:object-cover"
  : "h-full w-full object-contain";
const imageStyle = fullHeight ? `object-position:${imagePosition}` : undefined;
---

<article class={articleClass} style={`background-color:${bg}`}>
  <div
    class={textWrapClass}
    style={textColor ? `color:${textColor}` : undefined}
  >
  <div class="flex items-center gap-3">
    {logo && (
      <img
        src={logo}
        alt={`${title} logo`}
        class={`${logoClass} ${logoInvert ? "invert" : ""}`}
      />
    )}
    {showTitle && (
      <h3 class={`text-2xl font-semibold tracking-tight sm:text-3xl ${textColor ? "" : "text-zinc-900"}`}>{title}</h3>
    )}
  </div>
  {subtitle && (
    <p class={`mt-4 max-w-md text-lg font-medium leading-snug tracking-tight sm:text-xl ${textColor ? "" : "text-zinc-900"}`}>
      {subtitle}
    </p>
  )}
  <p class={`${subtitle ? "mt-3" : "mt-4"} max-w-md text-base leading-relaxed sm:text-lg ${textColor ? "opacity-90" : "text-zinc-500"}`}>
    {description}
  </p>

  {tags.length > 0 && (
    <div class={rowJustifyClass}>
      {tags.map((tag) => (
        <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600">
          {tag}
        </span>
      ))}
    </div>
  )}

  {inlineLinks ? (
    <ProjectLinks
      title={title}
      appStore={appStore}
      playStore={playStore}
      web={web}
      github={github}
      size="xs"
      class={rowJustifyClass}
    />
  ) : (
    <div class={rowJustifyClass}>
      <button
        type="button"
        data-modal-open={modalId}
        data-ph-project={title}
        class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-300 hover:bg-zinc-50"
      >
        Learn more
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
    </div>
  )}

  </div>

  {image && (
    <div
      class={imageWrapClass}
      style={fullHeight ? undefined : `aspect-ratio:${imageAspect}`}
    >
      <img
        src={image}
        alt={title}
        loading="lazy"
        class={imageClass}
        style={imageStyle}
      />
    </div>
  )}
</article>

{!inlineLinks && (
  <ProjectModal
    id={modalId}
    title={title}
    longDescription={longDescription}
    logo={logo}
    logoInvert={logoInvert}
    showTitle={showTitle}
    appStore={appStore}
    playStore={playStore}
    web={web}
    github={github}
  />
)}
