---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PostHog from "../components/posthog.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Alex Amayo — Mobile Developer. When You Need A Developer Who Delivers.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Alex Amayo</title>
    <PostHog />
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Every "Get In Touch" affordance is a plain mailto: link. Clicking one
      // still opens the mail client; alongside that we copy the address to the
      // clipboard, since some visitors have no mail client wired up.
      // Also replaces the old contact-form submit event.
      var toastTimer;

      function showToast(message) {
        var toast = document.getElementById('copy-toast');

        if (!toast) {
          toast = document.createElement('div');
          toast.id = 'copy-toast';
          toast.setAttribute('role', 'status');
          toast.setAttribute('aria-live', 'polite');
          toast.style.cssText =
            'position:fixed;left:50%;bottom:2rem;transform:translateX(-50%);' +
            'z-index:100;border-radius:9999px;background:rgba(22,22,23,0.9);' +
            'padding:0.625rem 1.25rem;font-size:0.8125rem;font-weight:500;' +
            'color:#f5f5f7;backdrop-filter:blur(20px);pointer-events:none;' +
            'opacity:0;transition:opacity 200ms ease';
          document.body.appendChild(toast);
        }

        toast.textContent = message;
        // Force a reflow so the opacity transition runs on a freshly added node.
        void toast.offsetWidth;
        toast.style.opacity = '1';

        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toast.style.opacity = '0';
        }, 4500);
      }

      document.addEventListener('click', function (event) {
        var link = event.target.closest('a[href^="mailto:"]');
        if (!link) return;

        window.posthog?.capture('contact_email_clicked');

        // Strip the mailto: scheme and any ?subject=/&body= query params.
        var email = link.getAttribute('href').slice(7).split('?')[0];
        if (!email || !navigator.clipboard) return;

        navigator.clipboard.writeText(email).then(
          function () {
            showToast('Copied ' + email);
          },
          function () {
            // Clipboard blocked (permissions, insecure context) — the mailto:
            // navigation still happens, so stay silent rather than lie.
          }
        );
      });
    </script>
  </body>
</html>
